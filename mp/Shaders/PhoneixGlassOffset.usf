// =============================================================================
// PhoneixGlassOffset.usf — sample UV from P + R * vThickness (world space)
//
// Custom: CMOT_Float2  → absolute Viewport UV (0..1) of the refracted sample point
//   #include "/Project/PhoneixGlassOffset.usf"
//
// Inputs:
//   WorldPos       float3   Absolute World Position
//   Normal         float3   Pixel / vertex normal WS
//   CameraVector   float3   CameraVectorWS (toward camera)
//   IOR            float
//
// vThickness: CONSTANT for now (placeholder). Replace later (e.g. bake _DIST / atlas).
//   Do NOT use material Thickness param here — that drives body tint / optical stack only.
//
// Graph:
//   SampleUV = this Custom
//   Back     = Sample(GlassBackRT, SampleUV)
//   Scene    = SceneColor(Offset = SampleUV - ViewportUV)
//   SceneIn  = lerp(Scene, Back.rgb, Back.a)
// =============================================================================

// Placeholder constant — swap for bake/per-pixel later.
static const float kGlassSampleVThickness = 0.170842f;

float3 N = normalize(Normal);
float3 V = normalize(CameraVector);

float3 Incident = -V;
float Eta = 1.0f / max(IOR, 1.001f);
float3 R = refract(Incident, N, Eta);
if (dot(R, R) < 1e-8f)
{
	R = reflect(Incident, N);
}
R = normalize(R);

// P' = P + R * vThickness
float3 SampleWorldPos = WorldPos + R * kGlassSampleVThickness;

float3 TranslatedSamplePos = SampleWorldPos + LWCToFloat(ResolvedView.PreViewTranslation);
float4 Clip = mul(float4(TranslatedSamplePos, 1.0f), ResolvedView.TranslatedWorldToClip);
float InvW = rcp(max(abs(Clip.w), 1e-5f));
float2 Ndc = Clip.xy * InvW;
float2 SampleUV = float2(0.5f + 0.5f * Ndc.x, 0.5f - 0.5f * Ndc.y);
SampleUV = saturate(SampleUV);

return SampleUV;
