// =============================================================================
// PhoneixGlassOffset.usf — front sample UV
//
//   P' = P + R * _THICKNESS * RefractStrength
//
// Prefer this body INLINE in M_PhoneixGlass Custom_0 Code (not include-only),
// so CustomExpression0 keeps RefractStrength in the compiled signature.
// Keep this file as the source of truth / mirror.
// =============================================================================

#include "/Project/GlassDualPassBakeAttrs.ush"

FGlassBakeAttrs Bake;
float Convexity, Concavity, Thickness, DistAttr, Peaks;
Bake.Decode(VertexColor.rgb, VertexColorA, float2(0.0f, 0.0f), Convexity, Concavity, Thickness, DistAttr, Peaks);

float3 N = normalize(Normal);
float3 V = normalize(CameraVector);

float3 Incident = -V;
float Eta = 1.0f / max(IOR, 1.001f);
float3 R = refract(Incident, N, Eta);
if (dot(R, R) < 1e-8f)
{
	R = reflect(Incident, N);
}
R = normalize(R);

// P' = P + R * _THICKNESS * RefractStrength
float StepLen = Thickness * max(RefractStrength, 0.0f);
float3 SampleWorldPos = WorldPos + R * StepLen;

float3 TranslatedSamplePos = SampleWorldPos + LWCToFloat(ResolvedView.PreViewTranslation);
float4 Clip = mul(float4(TranslatedSamplePos, 1.0f), ResolvedView.TranslatedWorldToClip);
float InvW = rcp(max(abs(Clip.w), 1e-5f));
float2 Ndc = Clip.xy * InvW;
float2 SampleUV = float2(0.5f + 0.5f * Ndc.x, 0.5f - 0.5f * Ndc.y);
SampleUV = saturate(SampleUV);

// Keep channels + RefractStrength live for DCE / signature
SampleUV += float2(0.0f * (Convexity + Concavity + DistAttr + Peaks + RefractStrength), 0.0f);

return SampleUV;
