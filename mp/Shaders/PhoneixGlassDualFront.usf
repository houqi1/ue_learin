// =============================================================================
// PhoneixGlassDualFront.usf — front glass WITH dual-pass backface RT mix
//
// Drop-in replacement for PhoneixGlass.usf Custom body when closing the loop:
//   Backface pass writes RT_GlassBack → front samples it into SceneIn mix.
//
// Custom: CMOT_Float3
//   #include "/Project/PhoneixGlassDualFront.usf"
//
// All PhoneixGlass.usf inputs PLUS:
//   GlassBackRT    Texture2D  (param name GlassBackRT — subsystem sets this)
//   ScreenUV       float2     (viewport UV 0..1)
//   BackfaceWeight float      (0=off, 1=full backface; subsystem sets default)
//
// Scheme 4 (coverage mask):
//   RT_GlassBack is cleared to (0,0,0,0); backface PS writes a=1 on glass pixels.
//   Front: SceneMix = lerp(SceneIn, Back.rgb, Back.a * BackfaceWeight)
//   Non-glass RT pixels (a=0) keep SceneIn (SceneColor); no full-screen SceneColor blit.
// =============================================================================

struct FPhoneixGlass
{
	float Rim(float NoV, float InBias, float InScale, float InPower)
	{
		float InvNoV = saturate(1.0f - NoV);
		return saturate(InBias + InScale * pow(InvNoV, max(InPower, 0.0f)));
	}

	float3 Absorb(float3 Tint, float InThickness)
	{
		float t = saturate(InThickness);
		return lerp(Tint, (Tint * Tint) * 0.35f, t);
	}

	float3 ComposeBody(
		float3 RefractedScene,
		float3 InBaseTint,
		float InThickness,
		float InOpacity)
	{
		float3 BodyTint = Absorb(InBaseTint, InThickness);
		float Density = saturate(InOpacity);
		float3 ClearGlass = RefractedScene;
		float3 StainedGlass = RefractedScene * lerp(float3(1.0f, 1.0f, 1.0f), BodyTint * 2.0f, Density);
		return lerp(ClearGlass, StainedGlass, Density);
	}

	float3 ApplyEdgeGlow(
		float3 Glass,
		float3 InEdgeTint,
		float InThickness,
		float RimFresnel,
		float InGlow)
	{
		float3 Edge = InEdgeTint * (0.55f + 0.45f * RimFresnel);
		float Spec = pow(RimFresnel, 1.35f) * (0.3f + 0.7f * (1.0f - saturate(InThickness)));
		float3 ReflectionLobe = Edge * Spec;
		Glass = lerp(Glass, Glass * 0.35f + ReflectionLobe, RimFresnel * 0.35f);
		Glass += ReflectionLobe * 0.25f;
		Glass *= (1.0f + max(InGlow, 0.0f) * (0.25f + 0.75f * RimFresnel));
		return Glass;
	}
};

FPhoneixGlass PG;

float3 N = normalize(Normal);
float3 V = normalize(CameraVector);
float NoV = saturate(dot(N, V));

// Coverage mask from RT alpha (clear a=0; written glass a=1). Optional global weight.
float WBack = saturate(BackfaceWeight);
float4 BackSample = GlassBackRT.SampleLevel(GlassBackRTSampler, ScreenUV, 0);
float Coverage = saturate(BackSample.a) * WBack;
float3 SceneMix = lerp(SceneIn, BackSample.rgb, Coverage);

float RimFresnel = PG.Rim(NoV, FBias, FScale, FPower);
float3 Body = PG.ComposeBody(SceneMix, BaseTint, Thickness, Opacity);
float3 Color = PG.ApplyEdgeGlow(Body, EdgeTint, Thickness, RimFresnel, Glow);

return Color;
