// Kernel 6/6 — PROJECT / gradient subtract
//   u -= 0.5*N*(pR-pL) ;  v -= 0.5*N*(pU-pD)
//
// Signature matches Niagara Custom HLSL call in the project:
// SF_Project(PrevVelocity, PressL, PressR, PressD, PressU,
//            PrevDensity, PrevPressure, PrevDivergence, GridN,
//            OutVelocity, OutDensity, OutPressure, OutDivergence);

void SF_Project(
	float2 PrevVelocity,
	float PressL,
	float PressR,
	float PressD,
	float PressU,
	float PrevDensity,
	float PrevPressure,
	float PrevDivergence,
	float GridN,
	out float2 OutVelocity,
	out float OutDensity,
	out float OutPressure,
	out float OutDivergence)
{
	OutVelocity = SF_ProjectVelocity(PrevVelocity, PressL, PressR, PressD, PressU, GridN);
	OutDensity = PrevDensity;
	OutPressure = PrevPressure;
	OutDivergence = PrevDivergence;
}
