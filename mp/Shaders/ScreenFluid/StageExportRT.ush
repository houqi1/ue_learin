// Export Grid → RT (not part of Stam paper; required for screen PP).
// RG = velocity (UV/s), B/A = density for visibility / mask.

void SF_ExportRT(
	float2 PrevVelocity,
	float PrevDensity,
	out float4 OutColor)
{
	float dens = PrevDensity;
	OutColor = float4(PrevVelocity.x, PrevVelocity.y, dens, dens);
}
