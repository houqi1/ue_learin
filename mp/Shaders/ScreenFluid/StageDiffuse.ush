// Kernel 3/6 — DIFFUSE (implicit viscosity + density diffusion)
//   a = dt * k * N^2 ;  x = (x0 + a*sum_nb)/(1+4a)
// STAGE NumIterations = 20
//
// Signature matches Niagara Custom HLSL call in the project (20 args):
// SF_Diffuse(CenterVel, VelL, VelR, VelD, VelU,
//            CenterDens, DensL, DensR, DensD, DensU,
//            Dt, Viscosity, Diffusion, GridN,
//            PrevPressure, PrevDivergence,
//            OutVelocity, OutDensity, OutPressure, OutDivergence);

void SF_Diffuse(
	float2 CenterVel,
	float2 VelL,
	float2 VelR,
	float2 VelD,
	float2 VelU,
	float CenterDens,
	float DensL,
	float DensR,
	float DensD,
	float DensU,
	float Dt,
	float Viscosity,
	float Diffusion,
	float GridN,
	float PrevPressure,
	float PrevDivergence,
	out float2 OutVelocity,
	out float OutDensity,
	out float OutPressure,
	out float OutDivergence)
{
	float dt = max(Dt, 0.0);
	float n = max(GridN, 1.0);
	float aVel = dt * max(Viscosity, 0.0) * n * n;
	float aDens = dt * max(Diffusion, 0.0) * n * n;

	OutVelocity = SF_LinSolveVec(CenterVel, VelL, VelR, VelD, VelU, aVel);
	OutDensity = SF_LinSolveScalar(CenterDens, DensL, DensR, DensD, DensU, aDens);
	OutPressure = PrevPressure;
	OutDivergence = PrevDivergence;
}
