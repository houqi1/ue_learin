// Kernel 4/6 — DIVERGENCE (+ zero pressure for Poisson start)
//   div = -0.5/N * ((uR-uL)+(vU-vD)) ;  p = 0
// FORCE_RELOAD_STAMP: 2026-07-29-void-cast-fix
//
// Signature matches Niagara Custom HLSL call in the project (12 args):
// SF_Divergence(PrevVelocity, VelL, VelR, VelD, VelU,
//               PrevDensity, PrevPressure, GridN,
//               OutVelocity, OutDensity, OutPressure, OutDivergence);
// PrevPressure is accepted for pin compatibility (ignored; OutPressure forced to 0).

void SF_Divergence(
	float2 PrevVelocity,
	float2 VelL,
	float2 VelR,
	float2 VelD,
	float2 VelU,
	float PrevDensity,
	float PrevPressure,
	float GridN,
	out float2 OutVelocity,
	out float OutDensity,
	out float OutPressure,
	out float OutDivergence)
{
	// PrevPressure pin kept only for Niagara call compatibility; Stam zeros p here.
	// (Do not use C-style (void)x — invalid in HLSL.)
	OutDivergence = SF_DivergenceStam(VelL, VelR, VelD, VelU, GridN);
	OutPressure = 0.0 + 0.0 * PrevPressure;
	OutVelocity = PrevVelocity;
	OutDensity = PrevDensity;
}
