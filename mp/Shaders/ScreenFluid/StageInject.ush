// Stam add force/source — stroke inject:
//   - Density + force only when InjectPulse > 0 (host sets pulse from mouse *motion*)
//   - Force / density push along InjectDir (unit UV direction of movement)
//   - Spatial falloff: soft disc around ClickUV
//
// Virtual Include:
//   1) /Project/ScreenFluid/StageCommon.ush
//   2) /Project/ScreenFluid/StageInject.ush
// Body:
// SF_Inject(UnitToUV, ClickUV, InjectDir, Strength, Radius, InjectPulse, Dt,
//           PrevVelocity, PrevDensity, PrevPressure, PrevDivergence,
//           OutVelocity, OutDensity, OutPressure, OutDivergence);
//
// Niagara User params (from AScreenFluidActor):
//   ClickUV, InjectDir (Vector2), ClickStrength, ClickRadius, InjectPulse

void SF_Inject(
	float2 UnitToUV,
	float2 ClickUV,
	float2 InjectDir,
	float Strength,
	float Radius,
	float InjectPulse,
	float Dt,
	float2 PrevVelocity,
	float PrevDensity,
	float PrevPressure,
	float PrevDivergence,
	out float2 OutVelocity,
	out float OutDensity,
	out float OutPressure,
	out float OutDivergence)
{
	float dt = max(Dt, 0.0);
	float w = SF_SplatWeight(UnitToUV, ClickUV, Radius);
	float gate = saturate(InjectPulse);
	float dirLen = length(InjectDir);
	// Stationary or zero direction → no inject
	float moveGate = (dirLen > 1e-5) ? 1.0 : 0.0;
	float amp = max(Strength, 0.0) * gate * moveGate * w;

	float2 dir = (dirLen > 1e-5) ? (InjectDir / dirLen) : float2(0.0, 0.0);
	// Force along stroke direction (Stam external force F)
	float2 F = dir * amp;

	// u += dt*F ; d += dt*S  (S = amp along brush)
	OutVelocity = PrevVelocity + dt * F;
	OutDensity = PrevDensity + dt * amp;
	OutPressure = PrevPressure;
	OutDivergence = PrevDivergence;
}
