// Stam Stable Fluids — shared discrete ops (6-kernel GPU layout)
// Reference: Jos Stam SIGGRAPH 1999 / GDC discrete form
// Path: /Project/ScreenFluid/StageCommon.ush
// FORCE_RELOAD_STAMP: 2026-07-29-void-cast-fix

#ifndef SF_STABLE_FLUIDS_COMMON
#define SF_STABLE_FLUIDS_COMMON

float SF_SplatWeight(float2 UnitUV, float2 ClickUV, float RadiusUV)
{
	float r = length(UnitUV - ClickUV);
	float rad = max(RadiusUV, 1e-5);
	float t = saturate(1.0 - r / rad);
	return t * t;
}

float2 SF_UnitToIndex(float2 UnitUV, float N)
{
	return UnitUV * max(N, 1.0) - 0.5;
}

// Wall: zero normal velocity on domain edge (simple set_bnd)
float2 SF_SetBndVelocity(float2 UnitUV, float N, float2 vel)
{
	float2 idx = SF_UnitToIndex(UnitUV, N);
	float n = max(N, 1.0);
	float2 v = vel;
	if (idx.x < 0.5 || idx.x > n - 1.5) v.x = 0.0;
	if (idx.y < 0.5 || idx.y > n - 1.5) v.y = 0.0;
	return v;
}

// lin_solve step: a = dt*k*N^2 ; x = (x0 + a*sum_nb)/(1+4a)
float SF_LinSolveScalar(float Center0, float L, float R, float D, float U, float a)
{
	return (Center0 + a * (L + R + D + U)) / max(1.0 + 4.0 * a, 1e-8);
}

float2 SF_LinSolveVec(float2 Center0, float2 L, float2 R, float2 D, float2 U, float a)
{
	return float2(
		SF_LinSolveScalar(Center0.x, L.x, R.x, D.x, U.x, a),
		SF_LinSolveScalar(Center0.y, L.y, R.y, D.y, U.y, a));
}

// div = -0.5/N * ((uR-uL)+(vU-vD))
float SF_DivergenceStam(float2 VelL, float2 VelR, float2 VelD, float2 VelU, float N)
{
	float n = max(N, 1.0);
	return -0.5 * ((VelR.x - VelL.x) + (VelU.y - VelD.y)) / n;
}

// Stam lin_solve(p, div, a=1, c=4) with div already containing the leading minus:
//   div = -0.5/N * ((uR-uL)+(vU-vD))
//   p   = (div + pL+pR+pD+pU) / 4
// Do NOT use (Σp - div)/4 here — that is for positive divergence only.
float SF_PressureJacobi(float PressL, float PressR, float PressD, float PressU, float Div)
{
	return (PressL + PressR + PressD + PressU + Div) * 0.25;
}

// u -= 0.5*N*(pR-pL), v -= 0.5*N*(pU-pD)
float2 SF_ProjectVelocity(float2 Vel, float PressL, float PressR, float PressD, float PressU, float N)
{
	float n = max(N, 1.0);
	float2 grad = 0.5 * n * float2(PressR - PressL, PressU - PressD);
	return Vel - grad;
}

float2 SF_BacktraceUV(float2 UnitUV, float2 Velocity, float Dt)
{
	return saturate(UnitUV - Dt * Velocity);
}

#endif
