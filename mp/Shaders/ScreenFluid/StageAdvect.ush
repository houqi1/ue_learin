// Kernel 2/6 — ADVECT (semi-Lagrangian transport for velocity + density)
// Graph BEFORE call (must wire samples yourself):
//   UV_back = saturate(UnitToUV - Dt * Velocity)
//   SampleVel  = SamplePrevious Velocity  @ UV_back
//   SampleDens = SamplePrevious Density   @ UV_back
//
// Signature matches Niagara Custom HLSL pins currently in the project:
// SF_Advect(SampleVel, SampleDens, PrevPressure, PrevDivergence,
//           OutVelocity, OutDensity, OutPressure, OutDivergence);

void SF_Advect(
	float2 SampleVel,
	float SampleDens,
	float PrevPressure,
	float PrevDivergence,
	out float2 OutVelocity,
	out float OutDensity,
	out float OutPressure,
	out float OutDivergence)
{
	// Pure semi-Lagrangian result (boundary handled by sample UV saturate in graph)
	OutVelocity = SampleVel;
	OutDensity = SampleDens;
	OutPressure = PrevPressure;
	OutDivergence = PrevDivergence;
}
