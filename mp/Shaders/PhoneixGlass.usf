// =============================================================================
// PhoneixGlass.usf — front glass after SceneIn (incl. BackRT mix in graph)
//
// MUST be valid inside Material CustomExpression() — no free functions.
// All helpers live as struct methods (UE restriction).
//
// Custom: CMOT_Float3 — paste body or #include "/Project/PhoneixGlass.usf"
//
// Inputs:
//   Normal, CameraVector, SceneIn
//   BaseTint (= vGlassColor body), EdgeTint
//   Thickness, ThicknessDecay, Opacity
//   IOR, RefractStrength          (offset graph; kept for pin compat)
//   FBias, FScale, FPower, Glow   (rim / edge glow after optical stack)
//   UseTransmittance
//   FringeCurve, FringeMix, FringeColor
//   ColorBoost, ColorFactor, RgbCurve (float3)
//
// Post-SceneIn order:
//   1) × transmittance = 1 - UseTransmittance * Fresnel (grazing less T)
//   2) mix fringe (fringeness from |N·V|)
//   3) colorBoost (sat + mid contrast)
//   4) thickness body: exp(-Thickness*Decay) mix BaseTint
//   5) × ColorFactor
//   6) RGB pow curve (identity at 1)
//   7) rim edge glow (existing EdgeTint / Glow)
//
// Env reflection / colorsMap iridescence stay in material graph (add on Emissive).
// =============================================================================

struct FPhoneixGlass
{
	float Rim(float NoV, float InBias, float InScale, float InPower)
	{
		float InvNoV = saturate(1.0f - NoV);
		return saturate(InBias + InScale * pow(InvNoV, max(InPower, 0.0f)));
	}

	// Schlick F0≈0.04 glass/air; CosTheta = |N·V|
	float FresnelSchlick(float CosTheta)
	{
		const float R0 = 0.04f;
		const float OneMinus = saturate(1.0f - CosTheta);
		return R0 + (1.0f - R0) * pow(OneMinus, 5.0f);
	}

	float Luma(float3 C)
	{
		return dot(C, float3(0.2126f, 0.7152f, 0.0722f));
	}

	// Relative sat + mid-grey contrast. ColorBoost=1 → identity.
	float3 ApplyColorBoost(float3 C, float Boost)
	{
		const float B = max(Boost, 0.0f);
		const float L = Luma(C);
		// Saturation: push away from / toward grey
		C = L + (C - L) * B;
		// Contrast about 0.5
		C = 0.5f + (C - 0.5f) * B;
		return C;
	}

	// Thick → more body color (BaseTint); thin → keep scene. W = 1 - exp(-t*decay)
	float3 ApplyThicknessBody(float3 C, float3 GlassColor, float InThickness, float Decay)
	{
		const float T = max(InThickness, 0.0f);
		const float D = max(Decay, 0.0f);
		const float Remain = exp(-T * D); // 1 at t=0, →0 when thick
		// Remain high: keep C; Remain low: eat toward GlassColor * C (absorb) then toward tint
		const float3 Stained = C * max(GlassColor, 0.0f.xxx);
		const float3 BodyMix = lerp(GlassColor, Stained, Remain);
		return lerp(BodyMix, C, Remain);
	}

	// Per-channel pow; RgbCurve = (1,1,1) identity. Values <1 lift mids / soft contrast.
	float3 ApplyRgbCurve(float3 C, float3 Curve)
	{
		const float3 E = max(Curve, 1e-3f.xxx);
		return pow(max(C, 0.0f.xxx), E);
	}

	float3 ApplyEdgeGlow(
		float3 Glass,
		float3 InEdgeTint,
		float InThickness,
		float RimFresnel,
		float InGlow)
	{
		float3 Edge = InEdgeTint * (0.55f + 0.45f * RimFresnel);
		float Spec = pow(RimFresnel, 1.35f) * (0.3f + 0.7f * (1.0f - saturate(InThickness)));
		float3 ReflectionLobe = Edge * Spec;
		Glass = lerp(Glass, Glass * 0.35f + ReflectionLobe, RimFresnel * 0.35f);
		Glass += ReflectionLobe * 0.25f;
		Glass *= (1.0f + max(InGlow, 0.0f) * (0.25f + 0.75f * RimFresnel));
		return Glass;
	}
};

FPhoneixGlass PG;

float3 N = normalize(Normal);
float3 V = normalize(CameraVector);
float NoV = saturate(dot(N, V));
// |N·V| for fringe / fresnel (two-sided safe)
float AbsNV = abs(dot(N, V));

float3 Color = SceneIn;

// -----------------------------------------------------------------------------
// 1) Transmittance: 1 - useTransmittance * Fresnel (grazing → less T)
// -----------------------------------------------------------------------------
float Fview = PG.FresnelSchlick(AbsNV);
float Transmittance = 1.0f - saturate(UseTransmittance) * Fview;
Color *= Transmittance;

// -----------------------------------------------------------------------------
// 2) Edge fringe: mix(color, fringeColor, fringeness), fringeness ~ |N·V|
// -----------------------------------------------------------------------------
float Fringeness =
	pow(saturate(1.0f - AbsNV), max(FringeCurve, 0.01f)) * FringeMix;
Color = lerp(Color, FringeColor.rgb, saturate(Fringeness));

// -----------------------------------------------------------------------------
// 3) colorBoost — sat + contrast (1 = neutral)
// -----------------------------------------------------------------------------
Color = PG.ApplyColorBoost(Color, ColorBoost);

// -----------------------------------------------------------------------------
// 4) Thickness body: exp(-vThickness * decay) mix vGlassColor (BaseTint)
// -----------------------------------------------------------------------------
Color = PG.ApplyThicknessBody(Color, BaseTint.rgb, Thickness, ThicknessDecay);

// Optional legacy Opacity: density blend toward stained (keeps old Opacity pin useful)
{
	float Density = saturate(Opacity);
	float3 Stained = Color * lerp(float3(1.0f, 1.0f, 1.0f), max(BaseTint.rgb, 0.0f.xxx) * 2.0f, Density);
	Color = lerp(Color, Stained, Density);
}

// -----------------------------------------------------------------------------
// 5) colorFactor — overall intensity
// -----------------------------------------------------------------------------
Color *= ColorFactor;

// -----------------------------------------------------------------------------
// 6) RGB curve pow (curve < 1 softens; =1 identity)
// -----------------------------------------------------------------------------
Color = PG.ApplyRgbCurve(Color, RgbCurve.rgb);

// -----------------------------------------------------------------------------
// 7) Existing rim / edge glow (EdgeTint, FBias/FScale/FPower, Glow)
// -----------------------------------------------------------------------------
float RimFresnel = PG.Rim(NoV, FBias, FScale, FPower);
Color = PG.ApplyEdgeGlow(Color, EdgeTint.rgb, Thickness, RimFresnel, Glow);

return max(Color, 0.0f.xxx);
