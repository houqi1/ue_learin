// =============================================================================
// PhoneixGlass.usf — refracted SceneIn (tint / rim / glow)
//
// MUST be valid inside Material CustomExpression() — no free functions.
// All helpers live as struct methods (UE restriction).
//
// Custom: CMOT_Float3 — paste body or #include "/Project/PhoneixGlass.usf"
//
// Inputs: Normal, CameraVector, SceneIn, BaseTint, EdgeTint, Thickness,
//         IOR, RefractStrength, FBias, FScale, FPower, Glow, Opacity
//
// Environment reflection is NOT mixed here. Graph iridescence only:
//   lut  = colorsMap (view/normal row)
//   iridTint = reflectionIridescence * (lut - 1) + 1   // lerp(1, lut, w)
//   irid = EnvMap * IridFresnel * iridTint
//   final = glass + irid
// =============================================================================

struct FPhoneixGlass
{
	float Rim(float NoV, float InBias, float InScale, float InPower)
	{
		float InvNoV = saturate(1.0f - NoV);
		return saturate(InBias + InScale * pow(InvNoV, max(InPower, 0.0f)));
	}

	float3 Absorb(float3 Tint, float InThickness)
	{
		float t = saturate(InThickness);
		return lerp(Tint, (Tint * Tint) * 0.35f, t);
	}

	float3 ComposeBody(
		float3 RefractedScene,
		float3 InBaseTint,
		float InThickness,
		float InOpacity)
	{
		float3 BodyTint = Absorb(InBaseTint, InThickness);
		float Density = saturate(InOpacity);
		float3 ClearGlass = RefractedScene;
		float3 StainedGlass = RefractedScene * lerp(float3(1.0f, 1.0f, 1.0f), BodyTint * 2.0f, Density);
		return lerp(ClearGlass, StainedGlass, Density);
	}

	float3 ApplyEdgeGlow(
		float3 Glass,
		float3 InEdgeTint,
		float InThickness,
		float RimFresnel,
		float InGlow)
	{
		float3 Edge = InEdgeTint * (0.55f + 0.45f * RimFresnel);
		float Spec = pow(RimFresnel, 1.35f) * (0.3f + 0.7f * (1.0f - saturate(InThickness)));
		float3 ReflectionLobe = Edge * Spec;
		Glass = lerp(Glass, Glass * 0.35f + ReflectionLobe, RimFresnel * 0.35f);
		Glass += ReflectionLobe * 0.25f;
		Glass *= (1.0f + max(InGlow, 0.0f) * (0.25f + 0.75f * RimFresnel));
		return Glass;
	}
};

FPhoneixGlass PG;

float3 N = normalize(Normal);
float3 V = normalize(CameraVector);
float NoV = saturate(dot(N, V));

float RimFresnel = PG.Rim(NoV, FBias, FScale, FPower);
float3 Body = PG.ComposeBody(SceneIn, BaseTint, Thickness, Opacity);
float3 Color = PG.ApplyEdgeGlow(Body, EdgeTint, Thickness, RimFresnel, Glow);

return Color;
